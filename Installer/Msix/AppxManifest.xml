<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest for Abbrevio.

  Packages Abbrevio as a classic Win32 "Desktop Bridge" app (EntryPoint =
  Windows.FullTrustApplication) rather than a sandboxed UWP app, since it's
  an existing native Win32 executable, not rewritten for the UWP app model.

  PLACEHOLDER VALUES — must be replaced before this can be submitted to the
  Microsoft Store:
    - Identity/@Name and Identity/@Publisher must exactly match the values
      assigned when you reserve the app name in Partner Center
      (https://partner.microsoft.com/dashboard). Until then, the values
      below only work for local sideload testing with a self-signed
      certificate (see BuildMsix.ps1).
    - Properties/PublisherDisplayName should match your Partner Center
      account's publisher display name.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap rescap">

  <Identity
      Name="CanScribe.Abbrevio"
      Publisher="CN=REPLACE_WITH_PARTNER_CENTER_PUBLISHER_ID"
      Version="16.0.0.0"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Abbrevio</DisplayName>
    <PublisherDisplayName>CanScribe</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Abbrevio" Executable="Abbrevio.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="Abbrevio"
          Description="Text snippet management tool for Windows"
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
            Wide310x150Logo="Assets\Square310x150Logo.png"
            Square310x310Logo="Assets\Square310x310Logo.png"
            Square71x71Logo="Assets\Square71x71Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
